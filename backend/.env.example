# =====================================================================
# ReRoute Backend Environment Configuration (FastAPI & YOLOv8)
# =====================================================================

# Server Bind Settings
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to SQLite at backend/ewaste_system.db)
DATABASE_URL=sqlite:///./ewaste_system.db

# YOLOv8 Model Weights Path
MODEL_PATH=best.pt

# Municipal Operator Verification Passkey
OPERATOR_SECRET_CODE=SMKC-ADMIN

# Environment ('development' or 'production')
ENVIRONMENT=development
